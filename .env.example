# AI Log Analyzer — ortam değişkenleri örneği.
# Bu dosyayı `.env` olarak kopyalayıp kendi değerlerinizi yazın. `.env` git'e girmez (bkz. .gitignore).

# --- Veritabanı ---
# Elle geliştirme (./mvnw spring-boot:run) için: localhost. NOT: `docker compose up` ile tam yığın
# çalıştırıldığında bu değer önemsizdir; app servisi container-içi host 'postgres'i compose'tan alır.
DB_URL=jdbc:postgresql://localhost:5432/loganalyzer
DB_USERNAME=loganalyzer
DB_PASSWORD=loganalyzer

# --- Yapay Zeka ---
# Google AI Studio'dan alınan ücretsiz Gemini API anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=buraya-api-anahtarini-yaz
# OpenAI yedek sağlayıcı (opsiyonel)
OPENAI_API_KEY=

# Aktif profil: 'mock' → AI çağrısı yapmadan sahte yanıt döner (anahtar gerekmez, demo/geliştirme için)
SPRING_PROFILES_ACTIVE=default

# --- Kimlik doğrulama (Gün 9) ---
# JWT imzalama anahtarı — üretimde MUTLAKA güçlü, gizli bir değerle değiştirin (HS256 için ≥32 bayt)
JWT_SECRET=change-me-in-production-please-32-bytes-minimum!!
# Boş bir veritabanında oluşturulacak varsayılan yönetici (ilk girişten sonra şifreyi değiştirin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
